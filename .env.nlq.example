# Только для контейнера nlq-agent (LLM). Остальное агент берёт из .env.

# Любой OpenAI-совместимый API; пусто = OpenRouter (https://openrouter.ai/api/v1).
# Примеры: https://api.openai.com/v1, https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
# Для новых моделей OpenAI: max_completion_tokens
LLM_MAX_TOKENS_FIELD=max_tokens
# Модели: основная, резервная (идентификаторы как у выбранного API)
NLQ_MODELS=z-ai/glm-5.3-flash
# llm | rules (без LLM) | fake
NLQ_LLM=llm
# При отказе LLM отвечать упрощённым режимом rules
NLQ_RULES_FALLBACK=true
