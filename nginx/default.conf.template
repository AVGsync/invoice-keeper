# HTTP: проверка домена для Let's Encrypt и редирект на HTTPS.
server {
  listen 80 default_server;
  server_name ${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${DOMAIN};

  # Сертификат монтируется с хоста в /etc/nginx/certs (см. docker-compose.yaml,
  # выпуск — scripts/cert.sh).
  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         HIGH:!aNULL:!MD5;

  client_max_body_size 2m;

  # Docker DNS: адреса контейнеров перечитываются каждые 10 с. Без этого nginx
  # запоминает IP при старте, и после пересоздания backend/miniapp/frontend
  # (docker compose up с новыми образами) их IP могут поменяться местами —
  # тогда /api уходит в miniapp, а /tg в backend (оба слушают 8080).
  # Переменная в proxy_pass заставляет nginx резолвить имя на каждый запрос.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend_upstream  http://backend:8080;
  set $miniapp_upstream  http://miniapp:8080;
  set $frontend_upstream http://frontend:3000;

  # SSE-стриминг ассистента: отключаем буферизацию и держим соединение дольше
  # обычного (ответ агента до ~25 с). Более длинный префикс, чем /api/, поэтому
  # nginx выбирает этот location для /api/v1/assistant/ask/stream
  # (docs/NL_QUERIES.md §9.4, §10.2). Go также ставит X-Accel-Buffering: no.
  location /api/v1/assistant/ask/stream {
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    chunked_transfer_encoding on;
  }

  # Backend: /api/... уходит как есть (маршруты бэка начинаются с /api/v1).
  location /api/ {
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # Telegram Mini App (miniapp/, отдельный статичный образ). НЕ ставим
  # X-Frame-Options/frame-ancestors: Telegram Web открывает Mini App в iframe.
  location = /tg { return 301 /tg/; }

  location /tg/ {
    proxy_pass $miniapp_upstream;          # без URI: путь /tg/... уходит как есть
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Frontend (Nuxt SSR).
  location / {
    proxy_pass $frontend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# Файл подключается внутрь http{}, так что map можно объявить здесь.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}
