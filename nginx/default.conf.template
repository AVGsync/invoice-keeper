# HTTP: проверка домена для Let's Encrypt и редирект на HTTPS.
server {
  listen 80 default_server;
  server_name ${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${DOMAIN};

  # Сертификат выпускает scripts/cert.sh и монтирует docker-compose.yaml.
  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         HIGH:!aNULL:!MD5;

  client_max_body_size 12m;

  # Имена контейнеров резолвятся динамически: после пересоздания контейнеров
  # IP меняются, а nginx иначе помнит старые и путает backend с miniapp.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend_upstream  http://backend:8080;
  set $miniapp_upstream  http://miniapp:8080;
  set $frontend_upstream http://frontend:3000;

  # SSE-стрим ассистента: без буферизации и с увеличенным таймаутом.
  location /api/v1/assistant/ask/stream {
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    chunked_transfer_encoding on;
  }

  # Backend.
  location /api/ {
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # Mini App: X-Frame-Options не ставим, Telegram Web открывает её в iframe.
  location = /tg { return 301 /tg/; }

  location /tg/ {
    proxy_pass $miniapp_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Frontend.
  location / {
    proxy_pass $frontend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# Подключается внутрь http{}.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}
