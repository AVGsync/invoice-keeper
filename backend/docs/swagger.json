    "definitions": {
        "model.Persona": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "Когда создана.",
                    "type": "string",
                    "example": "2026-10-23T20:05:31Z"
                },
                "description": {
                    "description": "Описание, до 255 символов; `null`, если не задано.",
                    "type": "string",
                    "x-nullable": true,
                    "example": "Оплачивает аренду и подписки"
                },
                "id": {
                    "description": "Идентификатор персоны.",
                    "type": "string",
                    "format": "uuid",
                    "example": "223f4e8e-98ea-4e50-9fb7-a9ea8984b2f1"
                },
                "name": {
                    "description": "Название, 1–64 символа, уникально без учёта регистра.",
                    "type": "string",
                    "example": "Бухгалтер"
                },
                "users_count": {
                    "description": "Сколько пользователей с этой персоной.",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.PersonaRef": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "Идентификатор персоны.",
                    "type": "string",
                    "format": "uuid",
                    "example": "223f4e8e-98ea-4e50-9fb7-a9ea8984b2f1"
                },
                "name": {
                    "description": "Название персоны.",
                    "type": "string",
                    "example": "Бухгалтер"
                }
            }
        },
        "model.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "Когда создан.",
                    "type": "string",
                    "example": "2026-10-23T20:05:31Z"
                },
                "full_name": {
                    "description": "Полное имя.",
                    "type": "string",
                    "example": "Ольга Иванова"
                },
                "id": {
                    "description": "Идентификатор пользователя.",
                    "type": "string",
                    "format": "uuid",
                    "example": "9a191dfa-5e71-47aa-bcb2-ed5e9c071830"
                },
                "login": {
                    "description": "Логин для входа.",
                    "type": "string",
                    "example": "olga"
                },
                "persona": {
                    "description": "Персона (должность) пользователя; `null`, если не назначена или была удалена.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.PersonaRef"
                        }
                    ],
                    "x-nullable": true
                },
                "role": {
                    "description": "Роль: `admin` — администратор из .env, `user` — обычный пользователь.",
                    "type": "string",
                    "enum": [
                        "admin",
                        "user"
                    ],
                    "example": "user"
                }
            }
        },
        "request.CreatePersonaRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "description": {
                    "description": "Описание, до 255 символов. Необязательно; пустая строка сохраняется как `null`.",
                    "type": "string",
                    "maxLength": 255,
                    "example": "Оплачивает аренду и подписки"
                },
                "name": {
                    "description": "Название, 1–64 символа (пробелы по краям обрезаются), уникально без учёта регистра.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1,
                    "example": "Бухгалтер"
                }
            }
        },
        "request.CreateUserRequest": {
            "type": "object",
            "required": [
                "full_name",
                "login",
                "password"
            ],
            "properties": {
                "full_name": {
                    "description": "Полное имя пользователя, отображается в профиле.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "Иван Петров"
                },
                "login": {
                    "description": "Уникальный логин, используется для входа.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "ivan.petrov"
                },
                "password": {
                    "description": "Пароль, минимум 8 символов. Роль не передаётся: создаётся всегда обычный пользователь.",
                    "type": "string",
                    "minLength": 8,
                    "example": "Str0ngPass!2026"
                },
                "persona_id": {
                    "description": "Персона (должность) из `GET /personas`. Необязательно: без поля пользователь\nсоздаётся без персоны. Несуществующий id → `400 persona not found`.",
                    "type": "string",
                    "format": "uuid",
                    "example": "223f4e8e-98ea-4e50-9fb7-a9ea8984b2f1"
                }
            }
        },
        "request.LoginRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "description": "Логин зарегистрированного пользователя.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "ivan.petrov"
                },
                "password": {
                    "description": "Пароль пользователя.",
                    "type": "string",
                    "example": "Str0ngPass!2026"
                }
            }
        },
        "request.UpdatePersonaRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "description": "Новое описание, до 255 символов. Если поле не передано, не меняется;\nпустая строка `\"\"` удаляет описание.",
                    "type": "string",
                    "maxLength": 255,
                    "example": "Оплачивает аренду, подписки и налоги"
                },
                "name": {
                    "description": "Новое название, 1–64 символа. Если поле не передано, текущее значение не меняется.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1,
                    "example": "Главный бухгалтер"
                }
            }
        },
        "request.UserUpdateRequest": {
            "type": "object",
            "properties": {
                "full_name": {
                    "description": "Новое полное имя. Если поле не передано, текущее значение не меняется.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "Иван Сергеевич Петров"
                },
                "login": {
                    "description": "Новый логин. Если поле не передано, текущее значение не меняется.",
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3,
                    "example": "ivan.new"
                }
            }
        },
        "response.PersonaListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "description": "Персоны, отсортированные по названию (без учёта регистра).",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Persona"
                    }
                },
                "total": {
                    "description": "Сколько всего персон.",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "response.UserListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.User"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "\"Bearer \u003caccess token\u003e\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "CookieAuth": {
            "type": "apiKey",
            "name": "AccessToken",
            "in": "cookie"
        }
    },
    "tags": [
        {
            "description": "Служебные эндпоинты (проверка доступности).",
            "name": "Система"
        },
        {
            "description": "Вход, выход, обновление токенов и текущий пользователь.",
            "name": "Auth"
        },
        {
            "description": "Управление пользователями — только администратор. Учётка администратора задаётся в .env и через API не меняется.",
            "name": "Admin"
        },
        {
            "description": "Справочник персон — должностей или зон ответственности (Бухгалтер, Руководитель, DevOps). Ведёт администратор; при создании пользователя персона выбирается из этого списка (`persona_id` в `POST /users`). На права доступа не влияет — права задаёт роль.",
            "name": "Personas"
        }
    ]
}