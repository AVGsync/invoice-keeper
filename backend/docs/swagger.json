                        }
                    },
                    "404": {
                        "description": "Пользователь не найден",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "На пользователя ссылаются другие записи",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "CookieAuth": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Частичное (PATCH) обновление данных обычного пользователя: ФИО и/или логин.\nРоль и пароль этим методом не меняются. Учётку администратора менять нельзя —\nона задаётся в .env. Доступно только роли `admin`.\n\nТело — только изменяемые поля (оба опциональны, но хотя бы одно обязательно):\n- `full_name`: если передан — 3–64 символа;\n- `login`: если передан — 3–32 символа, только `[a-zA-Z0-9_.-]`.\n\nКоды ответов:\n- `200` — пользователь обновлён;\n- `400 invalid user id` — `id` не UUID;\n- `400 invalid request body` — тело не парсится; либо текст ошибки валидации\n(в т.ч. `at least one field must be provided`, если оба поля пусты);\n- `401 unauthorized` / `403 forbidden` — из middleware Auth/IsAdmin;\n- `403 admin account is managed via .env` — попытка изменить администратора;\n- `404 user not found` — пользователя с таким `id` нет;\n- `409 user with this login already exists` — логин занят;\n- `500 failed to update user` — ошибка БД.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
