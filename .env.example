APP_ENV=local
BIND_ADDR=8080
LOG_LEVEL=debug
DEBUG=true
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
TTL_ACCESS_TOKEN=3600
TTL_REFRESH_TOKEN=604800
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Администратор из .env (через панель не управляется)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

POSTGRES_USER=invoice_keeper
POSTGRES_PASSWORD=invoice_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoice_keeper
LOCAL_POSTGRES_PORT=5432
LOCAL_API_PORT=8080
# Только docker-compose.local.yaml: pgAdmin (порт на хосте, логин, пароль).
LOCAL_PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=ad@ad.com
PGADMIN_DEFAULT_PASSWORD=admin

# SMTP для email-уведомлений — НЕОБЯЗАТЕЛЬНО (решение №1: напоминания идут только
# в командный чат Telegram, email не используется). Пустой SMTP_HOST = SMTP
# выключен, приложение стартует нормально. Непустой host требует полной
# конфигурации (port, username, password, from), иначе старт упадёт.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

TZ=Europe/Moscow
# TZ влияет только на системные логи; на бизнес-логику НЕ влияет — её задаёт
# ТОЛЬКО APP_TIMEZONE (на нём считаются «сегодня» и окно напоминаний).
APP_TIMEZONE=Europe/Moscow

# ---- Telegram-бот и напоминания (docs/TELEGRAM_BOT.md) ----
# Режим приёма апдейтов: off | polling | webhook.
#  - off     — бот выключен, приложение работает (дефолт).
#  - polling — локально, ТОЛЬКО отдельный dev-бот (прод-токен уведёт апдейты прода).
#  - webhook — прод.
TELEGRAM_MODE=off
# Пустой токен => бот выключен (решение №7), приложение всё равно стартует.
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для deep link и кнопки «Открыть» в напоминании).
TELEGRAM_BOT_USERNAME=invoiice_keeper_bot
# short_name Mini App из BotFather (/newapp). Пусто => основное Mini App бота.
TELEGRAM_MINIAPP_SHORT_NAME=
# Нужны ТОЛЬКО в режиме webhook с непустым токеном:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Начальное значение командного чата (seed применяется только при REMINDER_SOURCE=db).
TELEGRAM_TEAM_CHAT_ID=
# URL Mini App на нашем домене (web_app-кнопка в личке /start).
MINIAPP_URL=
TELEGRAM_INITDATA_MAX_AGE=10m
# Базовый URL Bot API (менять только в тестах; дефолт — официальный).
# TELEGRAM_API_URL=https://api.telegram.org

# Источник периодов: db (SQL по таблицам B, дефолт) | stub (in-memory демо,
# сообщения помечаются [DEMO] — только для демонстрации без базы).
# stub при включённом боте в production запрещён (иначе краш на старте).
REMINDER_SOURCE=db
REMINDER_LEAD_DAYS=3
REMINDER_TICK=30s

# ---- NL-ассистент «спроси про платежи» (docs/NL_QUERIES.md §10.1) ----
# Go — единственная публичная точка входа: /api/v1/assistant/ask[/stream],
# /api/v1/assistant/status. Приложение работает и при NLQ_ENABLED=false.
#
# Генерация пары ключей actor-JWT (один раз): Ed25519, Go подписывает приватным,
# агент и MCP проверяют публичным. Выводит обе строки:
#   docker run --rm ghcr.io/avgsync/invoice-keeper-nlq:latest nlq.keygen
#   (локально:  cd nlq && uv run python -m nlq.keygen)

# backend:
# включает ручки /api/v1/assistant/* (при false ask отвечает 503, status — enabled:false)
NLQ_ENABLED=true
# адрес агента во внутренней сети (Go на хосте: http://localhost:8090)
NLQ_AGENT_URL=http://nlq-agent:8090
# общий таймаут вопроса (строго меньше WriteTimeout 30s)
NLQ_TIMEOUT=25s
# вопросов в минуту на пользователя
NLQ_RATE_PER_MIN=10
# вопросов в сутки на пользователя
NLQ_DAILY_LIMIT=200
# одновременных вопросов на процесс (семафор)
NLQ_MAX_CONCURRENT=4
# base64(32-байтный Ed25519 seed); ТОЛЬКО backend (пустое значение — не ставьте
# тут inline-комментарий: парсер .env прочитал бы его как значение ключа):
NLQ_ACTOR_PRIVATE_KEY=
# agent + mcp (не секрет); base64(32 байта публичного ключа), пустое значение:
# сгенерируйте пару: python -m nlq.keygen (private — только backend, public — mcp):
NLQ_ACTOR_PUBLIC_KEY=
# dbinit + mcp: пароль read-only роли nlq_reader (обязателен при NLQ_ENABLED):
NLQ_DB_PASSWORD=nlq_reader_password
# mcp: видимость обычного пользователя — team (все платежи команды) | own:
NLQ_USER_SCOPE=team
# agent: список моделей OpenRouter (primary,backup) с tool calling:
NLQ_MODELS=z-ai/glm-5.3-flash
# agent: режим «мозга» — openrouter (боевой) | rules (офлайн) | fake (тесты):
NLQ_LLM=openrouter
# agent: при отказе LLM пробовать детерминированный режим rules:
NLQ_RULES_FALLBACK=true
# agent + mcp: фиксированная дата YYYY-MM-DD для eval/демо (только APP_ENV != production):
NLQ_TODAY=
# dbinit + mcp: dev-схема с зеркалами таблиц — пусто в local/проде (таблицы B
# уже в public после мёржа); непустой только для pytest (NLQ_DEV_SCHEMA=nlq_test):
NLQ_DEV_SCHEMA=

# Ключ OpenRouter живёт ОТДЕЛЬНО, только у nlq-agent: скопируйте
# nlq/.env.nlq.example в .env.nlq (в корень репозитория, файл в .gitignore) и
# впишите OPENROUTER_API_KEY. В тот же .env.nlq можно положить и необязательные
# настройки агента (compose читает его через env_file, а не из этого .env):
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#   NLQ_PUBLIC_URL=https://localhost     # HTTP-Referer для OpenRouter (в проде задаётся из DOMAIN)
#   NLQ_MAX_LLM_CALLS=4  NLQ_MAX_TOOL_CALLS_PER_STEP=3  NLQ_MAX_TOKENS=700
#   NLQ_STEP_TIMEOUT=10  NLQ_TOOL_TIMEOUT=5  NLQ_TOTAL_TIMEOUT=22
# Полный список — docs/ENV.md.

# Только для docker-compose.yaml (прод)
# В проде также: APP_ENV фиксируется в compose (production), POSTGRES_* и
# JWT_*/ADMIN_PASSWORD обязательно сменить, ALLOWED_ORIGINS=https://<DOMAIN>,
# DEBUG=false (в compose дефолт DEBUG=true!), TELEGRAM_MODE=webhook (с токеном).
# Домен или публичный IP сервера (для IP сертификат живёт 6 дней, см. scripts/cert.sh)
DOMAIN=localhost
LE_EMAIL=
# IMAGE_PREFIX=ghcr.io/avgsync/invoice-keeper
# IMAGE_TAG=latest

