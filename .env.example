# Backend
APP_ENV=local
BIND_ADDR=8080
LOG_LEVEL=debug
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
TTL_ACCESS_TOKEN=3600
TTL_REFRESH_TOKEN=604800

# Администратор (через API не меняется)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# База данных
POSTGRES_USER=invoice_keeper
POSTGRES_PASSWORD=invoice_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoice_keeper

# Только docker-compose.local.yaml
LOCAL_POSTGRES_PORT=5432
LOCAL_API_PORT=8080
LOCAL_PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=ad@ad.com
PGADMIN_DEFAULT_PASSWORD=admin

# Чеки платежей: каталог файлов (в Docker это том) и максимальный размер файла, МБ
RECEIPTS_DIR=./data/receipts
RECEIPTS_MAX_MB=10

# Часовой пояс бизнес-логики («сегодня», окно напоминаний); TZ влияет только на логи
TZ=Europe/Moscow
APP_TIMEZONE=Europe/Moscow

# SMTP (необязательно): пустой SMTP_HOST отключает почту
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Письма-напоминания; ссылка в письме ведёт на PUBLIC_URL или на https://DOMAIN
EMAIL_REMINDERS_ENABLED=true
PUBLIC_URL=

# Telegram-бот: TELEGRAM_MODE = off | polling (локально, отдельный бот) | webhook (прод)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=invoiice_keeper_bot
TELEGRAM_MINIAPP_SHORT_NAME=
# Только для webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Командный чат по умолчанию (id из /chatid)
TELEGRAM_TEAM_CHAT_ID=
# Адрес Mini App: https://<DOMAIN>/tg
MINIAPP_URL=
TELEGRAM_INITDATA_MAX_AGE=10m

# Напоминания: REMINDER_SOURCE = db | stub (демо, в проде запрещён)
REMINDER_SOURCE=db
REMINDER_LEAD_DAYS=3
REMINDER_TICK=30s

# NL-ассистент. Ключи: docker run --rm ghcr.io/avgsync/invoice-keeper-nlq:latest nlq.keygen
NLQ_ENABLED=true
NLQ_AGENT_URL=http://nlq-agent:8090
NLQ_TIMEOUT=25s
NLQ_RATE_PER_MIN=10
NLQ_DAILY_LIMIT=200
NLQ_MAX_CONCURRENT=4
# Приватный ключ только у backend, публичный у agent и mcp
NLQ_ACTOR_PRIVATE_KEY=
NLQ_ACTOR_PUBLIC_KEY=
# Пароль read-only роли nlq_reader
NLQ_DB_PASSWORD=nlq_reader_password
# Видимость обычного пользователя: team | own
NLQ_USER_SCOPE=team
# LLM: любой OpenAI-совместимый API (OpenRouter, OpenAI, Groq, DeepSeek, vLLM, Ollama...).
# Пусто = OpenRouter (https://openrouter.ai/api/v1). Примеры: https://api.openai.com/v1, https://api.groq.com/openai/v1
LLM_BASE_URL=
# Ключ можно положить сюда или в .env.nlq (там он не попадёт в контейнер backend)
LLM_API_KEY=
# Для новых моделей OpenAI: max_completion_tokens
LLM_MAX_TOKENS_FIELD=max_tokens
# Модели: основная, резервная (идентификаторы как у выбранного API)
NLQ_MODELS=z-ai/glm-5.3-flash
# llm | rules (без LLM) | fake
NLQ_LLM=llm
NLQ_RULES_FALLBACK=true
# Память диалога: включена, ходов в контексте, срок, максимум ходов, хранить записей
NLQ_MEMORY_ENABLED=true
NLQ_MEMORY_TURNS=4
NLQ_MEMORY_TTL=2h
NLQ_MEMORY_MAX_TURNS=20
NLQ_HISTORY_KEEP=100
# Только для отладки
NLQ_TODAY=
NLQ_DEV_SCHEMA=

# Только docker-compose.yaml (прод): домен или публичный IP и почта для Let's Encrypt
DOMAIN=localhost
LE_EMAIL=
# IMAGE_PREFIX=ghcr.io/avgsync/invoice-keeper
# IMAGE_TAG=latest
