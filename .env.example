# Общее для compose и нескольких контейнеров. Остальное: .env.backend и .env.nlq.
# Первый запуск: cp .env.example .env && cp .env.backend.example .env.backend && cp .env.nlq.example .env.nlq

# База данных (postgres, migrate, backend, nlq-db-init)
POSTGRES_USER=invoice_keeper
POSTGRES_PASSWORD=invoice_local_password
POSTGRES_DB=invoice_keeper
# Только для запуска backend без Docker (make run)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Часовой пояс бизнес-логики («сегодня», окно напоминаний); TZ влияет только на логи
APP_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Прод (docker-compose.yaml): домен или публичный IP и почта для Let's Encrypt
DOMAIN=localhost
LE_EMAIL=
# IMAGE_PREFIX=ghcr.io/avgsync/invoice-keeper
# IMAGE_TAG=latest

# Ассистент, общие для агента и MCP. Ключи: docker run --rm ghcr.io/avgsync/invoice-keeper-nlq:latest nlq.keygen
# Публичный ключ (приватный лежит только в .env.backend)
NLQ_ACTOR_PUBLIC_KEY=
# Пароль read-only роли nlq_reader
NLQ_DB_PASSWORD=nlq_reader_password
# Видимость обычного пользователя: team | own
NLQ_USER_SCOPE=team
# Только для отладки
NLQ_TODAY=
NLQ_DEV_SCHEMA=

# Только docker-compose.local.yaml
LOCAL_POSTGRES_PORT=5432
LOCAL_API_PORT=8080
LOCAL_PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=ad@ad.com
PGADMIN_DEFAULT_PASSWORD=admin
