# Только для контейнера backend (в прод-compose читается через env_file).
# Пароль БД, домен и часовой пояс берутся из .env.

APP_ENV=local
BIND_ADDR=8080
LOG_LEVEL=debug
# true открывает Swagger; в проде поставьте false
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
TTL_ACCESS_TOKEN=3600
TTL_REFRESH_TOKEN=604800

# Администратор (через API не меняется)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Чеки платежей: каталог файлов (в Docker это том) и максимальный размер файла, МБ
RECEIPTS_DIR=./data/receipts
RECEIPTS_MAX_MB=10

# SMTP (необязательно): пустой SMTP_HOST отключает почту. Порт 587 часто закрыт хостером: пробуйте 2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Письма-напоминания; ссылка в письме ведёт на PUBLIC_URL или на https://DOMAIN
EMAIL_REMINDERS_ENABLED=true
PUBLIC_URL=

# Telegram-бот: TELEGRAM_MODE = off | polling (локально, отдельный бот) | webhook (прод)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=invoiice_keeper_bot
TELEGRAM_MINIAPP_SHORT_NAME=
# Только для webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Командный чат по умолчанию (id из /chatid)
TELEGRAM_TEAM_CHAT_ID=
# Адрес Mini App: https://<DOMAIN>/tg
MINIAPP_URL=
TELEGRAM_INITDATA_MAX_AGE=10m

# Напоминания: REMINDER_SOURCE = db | stub (демо, в проде запрещён)
REMINDER_SOURCE=db
REMINDER_LEAD_DAYS=3
REMINDER_TICK=30s

# NL-ассистент, сторона backend
NLQ_ENABLED=true
NLQ_AGENT_URL=http://nlq-agent:8090
NLQ_TIMEOUT=25s
NLQ_RATE_PER_MIN=10
NLQ_DAILY_LIMIT=200
NLQ_MAX_CONCURRENT=4
# Приватный ключ подписи: только здесь, парный публичный лежит в .env
NLQ_ACTOR_PRIVATE_KEY=
# Память диалога: включена, ходов в контексте, срок, максимум ходов, хранить записей
NLQ_MEMORY_ENABLED=true
NLQ_MEMORY_TURNS=4
NLQ_MEMORY_TTL=2h
NLQ_MEMORY_MAX_TURNS=20
NLQ_HISTORY_KEEP=100
